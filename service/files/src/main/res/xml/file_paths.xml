<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exactly the three directories `FileStore` hands out, and nothing above them. A provider that
         shares more than it has to is how a file this app owns ends up readable by an app that
         asked nicely. -->
    <cache-path name="cache" path="files/" />
    <files-path name="documents" path="documents/" />
    <files-path name="downloads" path="downloads/" />
</paths>
